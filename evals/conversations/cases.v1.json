    {
      "id": "10_unsupported",
      "category": "unsupported",
      "description": "Save valid budget changes while explaining the unsupported hotel request; do not forget it on a later message.",
      "steps": [
        {
          "name": "Create session",
          "body": {
            "initial_message": "My name is Alex and I'm leaving from Boston. My companion Jamie leaves from New York. We travel June 10 to June 14, 2099. My maximum round-trip airfare budget is $800 USD and Jamie's is $500 USD. Each of us can travel at most 10 hours one way including layovers."
          },
          "expected": {
            "http_status": 200,
            "state": "review",
            "fields": {
              "start_date": "2099-06-10",
              "end_date": "2099-06-14",
              "travelers.traveler_a.display_name": "Alex",
              "travelers.traveler_b.display_name": "Jamie",
              "travelers.traveler_a.origin_id": "boston_ma",
              "travelers.traveler_b.origin_id": "new_york_ny",
              "travelers.traveler_a.budget_usd": 800,
              "travelers.traveler_b.budget_usd": 500,
              "travelers.traveler_a.max_travel_time_hours": 10,
              "travelers.traveler_b.max_travel_time_hours": 10
            }
          }
        },
        {
          "name": "Budget and hotel",
          "body": {
            "message": "My round-trip airfare budget is $600 USD, and I want a hotel with a pool."
          },
          "expected": {
            "http_status": 200,
            "state": "collecting",
            "fields": {
              "travelers.traveler_a.budget_usd": 600
            },
            "preserve_except": [
              "travelers.traveler_a.budget_usd"
            ],
            "unsupported": true
          }
        },
        {
          "name": "Unrelated confirmation of origin",
          "body": {
            "message": "Jamie is still leaving from New York."
          },
          "expected": {
            "http_status": 200,
            "state": "collecting",
            "preserve_except": [],
            "unsupported": true
          }
        },
        {
          "name": "Reject unresolved confirmation",
          "body": {
            "action": "confirm"
          },
          "expected": {
            "http_status": 422
          }
        }
      ]
    },
    {
      "id": "11_acknowledge",
      "category": "unsupported",
      "description": "Explicitly excluding an unsupported request returns to review, never directly to results.",
      "steps": [
        {
          "name": "Create session",
          "body": {
            "initial_message": "My name is Alex and I'm leaving from Boston. My companion Jamie leaves from New York. We travel June 10 to June 14, 2099. My maximum round-trip airfare budget is $800 USD and Jamie's is $500 USD. Each of us can travel at most 10 hours one way including layovers."
          },
          "expected": {
            "http_status": 200,
            "state": "review",
            "fields": {
              "start_date": "2099-06-10",
              "end_date": "2099-06-14",
              "travelers.traveler_a.display_name": "Alex",
              "travelers.traveler_b.display_name": "Jamie",
              "travelers.traveler_a.origin_id": "boston_ma",
              "travelers.traveler_b.origin_id": "new_york_ny",
              "travelers.traveler_a.budget_usd": 800,
              "travelers.traveler_b.budget_usd": 500,
              "travelers.traveler_a.max_travel_time_hours": 10,
              "travelers.traveler_b.max_travel_time_hours": 10
            }
          }
        },
        {
          "name": "Ask for hotel",
          "body": {
            "message": "I want a hotel with a pool."
          },
          "expected": {
            "http_status": 200,
            "state": "collecting",
            "unsupported": true,
            "preserve_except": []
          }
        },
        {
          "name": "Agree to exclude hotel",
          "body": {
            "message": "Yes, continue without the hotel request."
          },
          "expected": {
            "http_status": 200,
            "state": "review",
            "unsupported": false,
            "deferred": true,
            "preserve_except": []
          }
        },
        {
          "name": "Confirm reviewed trip",
          "body": {
            "action": "confirm"
          },
          "expected": {
            "http_status": 200,
            "state": "results"
          }
        }
      ]
    },
