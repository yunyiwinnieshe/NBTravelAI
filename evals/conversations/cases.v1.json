{
  "version": "1.0",
  "description": "Synthetic session-level evaluation. Fixed future dates match fixture flights. Expectations describe behavior, not exact generated wording.",
  "cases": [
    {
      "id": "01_complete",
      "category": "complete",
      "description": "Complete details reach review; text does not confirm; structured confirmation returns recommendations.",
      "steps": [
        {
          "name": "Create session",
          "body": {
            "initial_message": "My name is Alex and I'm leaving from Boston. My companion Jamie leaves from New York. We travel June 10 to June 14, 2099. My maximum round-trip airfare budget is $800 USD and Jamie's is $500 USD. Each of us can travel at most 10 hours one way including layovers."
          },
          "expected": {
            "http_status": 200,
            "state": "review",
            "fields": {
              "start_date": "2099-06-10",
              "end_date": "2099-06-14",
              "travelers.traveler_a.display_name": "Alex",
              "travelers.traveler_b.display_name": "Jamie",
              "travelers.traveler_a.origin_id": "boston_ma",
              "travelers.traveler_b.origin_id": "new_york_ny",
              "travelers.traveler_a.budget_usd": 800,
              "travelers.traveler_b.budget_usd": 500,
              "travelers.traveler_a.max_travel_time_hours": 10,
              "travelers.traveler_b.max_travel_time_hours": 10
            }
          }
        },
        {
          "name": "Text is not confirmation",
          "body": {
            "message": "Yes, that looks right. Please confirm."
          },
          "expected": {
            "http_status": 200,
            "state": "review",
            "preserve_except": []
          }
        },
        {
          "name": "Confirm reviewed trip",
          "body": {
            "action": "confirm"
          },
          "expected": {
            "http_status": 200,
            "state": "results"
          }
        }
      ]
    },
    {
