APP_ENV=development
FLIGHT_PROVIDER=fixture
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_SUPPLIER_TIMEOUT_MS=10000

# DeepSeek extraction, standalone or through planning sessions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
# Use deepseek for natural-language app sessions; offline tests select fixture.
EXTRACTION_PROVIDER=fixture
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=30

# Optional local tracing dashboard. Set a password before enabling it.
ENABLE_LOCAL_AI_DASHBOARD=0
LOCAL_AI_DASHBOARD_PASSWORD=
